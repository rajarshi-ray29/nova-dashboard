# Nova dashboard local server config (git-ignored)
PORT=8420
HERMES_URL=http://raspberrypi.local:8642
HERMES_KEY=your-hermes-api-key-here
HERMES_MODEL=nova
HERMES_SESSION_KEY=nova-dashboard
PI_BRIDGE_URL=http://raspberrypi.local:8433
# Spoken-filler cache. Synthesis takes ~2.5 s per phrase on the Pi, so Nova's short
# acknowledgements are cached to disk and pre-synthesized at boot. TTS_CACHE=0 disables the
# cache, TTS_PREWARM=0 keeps the cache but skips the warm-up at start.
# TTS_CACHE_DIR=~/.cache/nova-dashboard/tts
# TTS_CACHE=1
# TTS_PREWARM=1

# Optional weather override (leave blank to auto-detect via IP)
WEATHER_LAT=
WEATHER_LON=
WEATHER_CITY=

# Conversation lanes (server.js): reasoning effort per lane — none|minimal|low|medium|high|xhigh|max.
# NOVA_QUICK_REASONING=none
# NOVA_DEEP_REASONING=high
# NOVA_GESTURES=0 stops telling Nova she has a robot head (no [nod]-style cues in replies).
# NOVA_GESTURES=1
# Reminders/timers are kept in NOVA_DATA_DIR/reminders.json (default ~/.local/share/nova-dashboard).
# NOVA_DATA_DIR=
